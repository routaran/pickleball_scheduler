        </div>
        <span class="rating rating-mid">3.50</span>
      </div>
      <div class="ladder-row">
        <span class="rank-badge">3</span>
        <div class="player-name" style="flex-grow: 1;">
          <span class="player-name">Player 7</span><a href="https://example.com/player-7" target="_blank" class="profile-link" title="View DUPR Profile">[link]</a>
        </div>
        <span class="rating rating-mid">3.40</span>
      </div>
      <div class="ladder-row">
