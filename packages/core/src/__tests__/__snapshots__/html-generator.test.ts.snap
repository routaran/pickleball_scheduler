        <div class="player-name" style="flex-grow: 1;">
          <span class="player-name">Player 8</span><a href="https://example.com/player-8" target="_blank" class="profile-link" title="View DUPR Profile">[link]</a>
        </div>
        <span class="rating rating-mid">3.30</span>
      </div>
    </div>
  </div>
</body>
</html>"
`;
