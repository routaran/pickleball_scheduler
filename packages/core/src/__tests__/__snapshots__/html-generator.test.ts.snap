          <span class="player-name">Player 5</span><a href="https://example.com/player-5" target="_blank" class="profile-link" title="View DUPR Profile">[link]</a>
        </div>
        <span class="rating rating-mid">3.60</span>
      </div>
      <div class="ladder-row">
        <span class="rank-badge">2</span>
        <div class="player-name" style="flex-grow: 1;">
