  <div class="container">
    <h1 class="page-title">Partner DUPR</h1>
    <p class="page-subtitle">February 2, 2026</p>
    <div class="header-stats">
      <span class="header-stat">2 Teams</span>
      <span class="header-stat">4/4 players resolved</span>
    </div>

    
    <div class="summary-card summary-success">
      <div style="display: flex; align-items: center;">
        <span style="margin-right: 0.5rem;">[check-circle]</span>
        <span><strong>4/4 players resolved</strong></span>
      </div>
  </div>

    <div class="pool">
      <div class="pool-header pool-a">
        <span class="pool-name">Pool A</span>
        <span class="pool-meta">(2 teams)</span>
      </div>
      <table class="partner-dupr-table">
        <thead>
          <tr>
            <th style="width: 60px;">#</th>
            <th>Team</th>
            <th style="width: 120px; text-align: center;">Ind. DUPR</th>
            <th style="width: 100px; text-align: right;">Team Rating</th>
          </tr>
        </thead>
        <tbody>
          <tr class="team-row">
