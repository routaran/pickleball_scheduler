                </div>
                <div class="player-cell">
                  <a href="https://dupr.com/jane" class="player-link" target="_blank">Jane Doe</a>
                </div>
              </div>
            </td>
            <td style="text-align: center;">
              <div class="individual-ratings">
                <span>4.25</span>
                <span>3.75</span>
              </div>
            </td>
            <td style="text-align: right;">
              <span class="team-dupr tier-high">3.92</span>
            </td>
          </tr>
          <tr class="team-row">
            <td>
              <div class="team-rank">2</div>
            </td>
            <td>
              <div class="team-players">
                <div class="player-cell">
